# Copy this file to `.env.crawler` and fill in your key(s).
# `.env.crawler` is gitignored — never commit real keys.

# Pexels (free): https://www.pexels.com/api/  -> "Get Started"
PEXELS_API_KEY=

# Wikimedia Commons needs no key, only a contact string for the User-Agent.
# Leave as-is or change to your own email / project URL.
WIKIMEDIA_CONTACT=mailto:a@a.com
